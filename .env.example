# ============================================================================
# Signal — Environment Configuration
# ============================================================================
# Copy this to .env and fill in your values

# --- Supabase / PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Google OAuth (Gmail API) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- LLM Providers ---
# Primary provider: gemini | groq
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq

# Gemini (Primary)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Groq (Fallback)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile

# --- Embeddings ---
# Options: minilm | tfidf
EMBEDDING_PROVIDER=minilm
# Model name for sentence-transformers (only used when EMBEDDING_PROVIDER=minilm)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Gmail Sync ---
# polling | push (use polling for local dev, push for production)
GMAIL_SYNC_MODE=polling
GMAIL_POLL_INTERVAL_SECONDS=60
# For push mode: your public webhook URL
GMAIL_PUSH_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/gmail
# Google Cloud Pub/Sub topic for Gmail push
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-push

# --- App Settings ---
APP_NAME=Signal
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Max emails to fetch on initial sync
INITIAL_SYNC_MAX_EMAILS=500

# Behavior model: min interactions before a pattern is considered reliable
BEHAVIOR_MIN_SAMPLE_SIZE=5
# Consecutive ignores before auto-demoting sender to tier 0
SENDER_AUTO_DEMOTE_THRESHOLD=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
